{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "application",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/*.css",
          "/*.js",
          "/favicon.svg",
          "/manifest.webmanifest",
          "/icons/*.png",
          "/fonts/*.woff2"
        ]
      }
    }
  ],
  "dataGroups": [],
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**", "!/auth/**", "!/api/**"],
  "navigationRequestStrategy": "performance"
}
