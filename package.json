{
  "name": "outify",
  "version": "0.3.0",
  "scripts": {
    "preinstall": "node scripts/require-pnpm.mjs",
    "ng": "ng",
    "start": "node scripts/configure.mjs && ng serve",
    "build": "node scripts/configure.mjs && ng build",
    "watch": "node scripts/configure.mjs && ng build --watch --configuration development",
    "test": "node scripts/configure.mjs && ng test",
    "test:config": "node --test scripts/configure.test.mjs scripts/verify-release.test.mjs",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "test:editor": "playwright test --config playwright.editor.config.ts",
    "test:server": "node --test server/account-deletion.test.mjs",
    "test:account:local": "node server/account-deletion.integration.mjs",
    "check:release": "node scripts/verify-release.mjs"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "12.4.2"
  },
  "packageManager": "pnpm@12.4.2",
  "dependencies": {
    "@angular/common": "21.2.10",
    "@angular/compiler": "21.2.10",
    "@angular/core": "21.2.10",
    "@angular/forms": "21.2.10",
    "@angular/platform-browser": "21.2.10",
    "@angular/router": "21.2.10",
    "@angular/service-worker": "21.2.10",
    "@supabase/supabase-js": "2.99.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.8",
    "@angular/cli": "21.2.8",
    "@angular/compiler-cli": "21.2.10",
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.58.2",
    "jsdom": "28.1.0",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  }
}
